# Servico de usuario (nao de sistema): precisa da sessao de audio do usuario.
#
#   mkdir -p ~/.config/systemd/user
#   cp systemd/aristoteles.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now aristoteles
#   journalctl --user -u aristoteles -f
#
# Requer wake.modo: openwakeword no config.yaml (push-to-talk precisa de terminal).

[Unit]
Description=Aristoteles - assistente de voz local
After=pipewire.service sound.target network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/aristoteles_python
Environment=PYTHONUNBUFFERED=1
# Opcional (o "-"): o app le a credencial de ~/.anthropic_api_key quando
# ANTHROPIC_API_KEY nao esta no ambiente, entao este arquivo nao precisa conter a
# chave. Duplica-la aqui foi o que quebrou o servico depois de uma rotacao: o
# original foi atualizado, a copia ficou com a chave revogada, e o app funcionava
# no terminal e devolvia 401 so como servico. Use este arquivo para OUTRAS
# variaveis de ambiente, se precisar.
EnvironmentFile=-%h/.config/aristoteles/env
ExecStart=%h/aristoteles_python/.venv/bin/python -m aristoteles
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
